# ─── MySQL local ──────────────────────────────────────────────────────────────
# Formato: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root:@localhost:3306/efiber"

# Ejemplos según tu servidor local:
# XAMPP/WAMP sin contraseña:  mysql://root:@localhost:3306/efiber
# XAMPP con contraseña:       mysql://root:mipassword@localhost:3306/efiber
# Laragon:                    mysql://root:@localhost:3306/efiber
# Docker MySQL:               mysql://root:root@localhost:3306/efiber

# ─── Nubefact (Facturación SUNAT) — opcional por ahora ────────────────────────
